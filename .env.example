# NGTeco Office Portal credentials
NGTECO_USER=your_ngteco_username
NGTECO_PASS=your_ngteco_password

# Optional: Residential proxy for GitHub Actions (NGTeco blocks data-center IPs)
# PROXY_URL=http://user:pass@proxy.example.com:8080

# Google Sheets - use ONE of these:
# Option A: Path to JSON file (for local runs)
# GOOGLE_SHEETS_JSON_PATH=C:\path\to\google-sheets.json
# Option B: JSON as string (for GitHub Actions)
# GOOGLE_SHEETS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}
