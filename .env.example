# NGTeco Office Portal credentials
NGTECO_USER=your_ngteco_username
NGTECO_PASS=your_ngteco_password

# Optional: Residential proxy to bypass NGTeco blocking GitHub Actions (data-center IPs)
# Format: http://user:pass@host:port or http://host:port
# PROXY_URL=http://user:pass@proxy.example.com:8080

# Google Sheets service account JSON (paste the entire JSON object as a single line)
GOOGLE_SHEETS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
